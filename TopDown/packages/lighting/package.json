{
  "name": "@jojo-d-little/storyboard-lighting",
  "private": false,
  "version": "0.1.0",
  "description": "PixiJS 8 top-down lighting pipeline package",
  "publishConfig": {
    "@jojo-d-little:registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "pixi.js": ">=8.0.0 <9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  }
}
