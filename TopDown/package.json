{
  "name": "pixi-lighting-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Pixi lighting component and harness",
  "scripts": {
    "build": "tsc -p .",
    "build:package": "npm --prefix packages/lighting run build",
    "dev": "tsc -p . --watch",
    "watch": "tsc -p . --watch",
    "typecheck": "tsc -p . --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:package": "npm --prefix packages/lighting run typecheck",
    "pack:package": "npm --prefix packages/lighting run pack:dry-run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "pixi.js": "^8.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
