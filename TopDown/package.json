{
  "name": "storyboard-lighting-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "StoryBoard lighting package and validation harness",
  "scripts": {
    "build": "npm run build:package",
    "build:package": "npm --prefix packages/lighting run build",
    "dev": "npm --prefix packages/lighting run build -- --watch",
    "watch": "npm --prefix packages/lighting run build -- --watch",
    "typecheck": "npm run typecheck:package",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:package": "npm --prefix packages/lighting run typecheck",
    "pack:package": "npm --prefix packages/lighting run pack:dry-run",
    "consumer:smoke": "npm run build:package && node programmatic-consumer/smoke.mjs",
    "consumer:packed-smoke": "npm run build:package && node programmatic-consumer/packed-smoke.mjs",
    "consumer:dev": "npm run build:package && vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "pixi.js": "^8.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
